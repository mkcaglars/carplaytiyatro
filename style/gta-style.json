{
  "version": 8,
  "name": "GTA Radar",
  "metadata": {
    "description": "Dark, high-contrast GTA-radar look on free OpenFreeMap / OpenMapTiles vector tiles."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "route": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      },
      "lineMetrics": true
    },
    "player": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    },
    "destination": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#16181b"
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "wood",
          "grass",
          "farmland"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#18211b",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landcover-sand",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "sand"
      ],
      "paint": {
        "fill-color": "#2a2720"
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "residential",
          "suburb",
          "neighbourhood"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#1c1e22"
      }
    },
    {
      "id": "landuse-industrial",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "industrial",
          "commercial",
          "retail",
          "railway"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#202227"
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#1a271f"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#13263a"
      }
    },
    {
      "id": "water-edge",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "line-color": "#24435f",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          16,
          2
        ]
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#13263a",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.5,
          16,
          4
        ]
      }
    },
    {
      "id": "aeroway-runway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "aeroway",
      "minzoom": 11,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "runway"
      ],
      "paint": {
        "line-color": "#2c2f35",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          3,
          16,
          40
        ]
      }
    },
    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "minor",
          "service",
          "tertiary"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#0b0c0e",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          12,
          1.5,
          18,
          22
        ]
      }
    },
    {
      "id": "road-major-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#0b0c0e",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          7,
          1.5,
          18,
          34
        ]
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 15,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "path",
          "track"
        ],
        true,
        false
      ],
      "paint": {
        "line-color": "#2e3136",
        "line-dasharray": [
          2,
          2
        ],
        "line-width": 1
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "minor",
          "service",
          "tertiary"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#3a3e44",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          12,
          0.6,
          18,
          18
        ]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "primary",
          "secondary"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#565b63",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          7,
          0.6,
          18,
          28
        ]
      }
    },
    {
      "id": "road-highway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#7b818a",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          5,
          0.6,
          18,
          30
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "rail"
      ],
      "paint": {
        "line-color": "#2b2e33",
        "line-dasharray": [
          3,
          3
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0.6,
          18,
          3
        ]
      }
    },
    {
      "id": "building",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-extrusion-color": "#25282d",
        "fill-extrusion-height": [
          "coalesce",
          [
            "get",
            "render_height"
          ],
          6
        ],
        "fill-extrusion-base": [
          "coalesce",
          [
            "get",
            "render_min_height"
          ],
          0
        ],
        "fill-extrusion-opacity": 0.85
      }
    },
    {
      "id": "route-glow-outer",
      "type": "line",
      "source": "route",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#a24bff",
        "line-opacity": 0.35,
        "line-blur": 12,
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          14,
          18,
          40
        ]
      }
    },
    {
      "id": "route-glow-inner",
      "type": "line",
      "source": "route",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#c27bff",
        "line-opacity": 0.75,
        "line-blur": 3,
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          6,
          18,
          16
        ]
      }
    },
    {
      "id": "route-core",
      "type": "line",
      "source": "route",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f1e2ff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          2,
          18,
          6
        ]
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "upcase",
          [
            "coalesce",
            [
              "get",
              "name:latin"
            ],
            [
              "get",
              "name"
            ]
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          9,
          18,
          13
        ],
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#9aa0a8",
        "text-halo-color": "#0b0c0e",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "water-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Italic"
        ],
        "text-size": 12,
        "text-letter-spacing": 0.15
      },
      "paint": {
        "text-color": "#4f7ba3",
        "text-halo-color": "#0b0c0e",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-neighbourhood",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 12,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "suburb",
          "neighbourhood",
          "quarter"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "upcase",
          [
            "coalesce",
            [
              "get",
              "name:latin"
            ],
            [
              "get",
              "name"
            ]
          ]
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          10,
          16,
          14
        ],
        "text-letter-spacing": 0.2,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#c8ccd2",
        "text-halo-color": "#0b0c0e",
        "text-halo-width": 2
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "maxzoom": 14,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "city",
          "town"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "upcase",
          [
            "coalesce",
            [
              "get",
              "name:latin"
            ],
            [
              "get",
              "name"
            ]
          ]
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          11,
          12,
          20
        ],
        "text-letter-spacing": 0.25
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "#0b0c0e",
        "text-halo-width": 2
      }
    },
    {
      "id": "destination-halo",
      "type": "circle",
      "source": "destination",
      "paint": {
        "circle-radius": 22,
        "circle-color": "#b44cff",
        "circle-opacity": 0.25,
        "circle-blur": 0.6
      }
    },
    {
      "id": "destination-blip",
      "type": "circle",
      "source": "destination",
      "paint": {
        "circle-radius": 9,
        "circle-color": "#b44cff",
        "circle-stroke-color": "#ffffff",
        "circle-stroke-width": 2.5
      }
    },
    {
      "id": "player-blip",
      "type": "symbol",
      "source": "player",
      "layout": {
        "icon-image": "player-arrow",
        "icon-size": 1,
        "icon-rotate": [
          "coalesce",
          [
            "get",
            "bearing"
          ],
          0
        ],
        "icon-rotation-alignment": "map",
        "icon-pitch-alignment": "map",
        "icon-allow-overlap": true,
        "icon-ignore-placement": true
      }
    }
  ]
}
